parameters:
        # pre-drupal-autoload.php (below) locates and requires the
        # surrounding site's own vendor/autoload.php so Composer's
        # InstalledVersions registry knows about drupal/core before
        # mglaman/phpstan-drupal's own bootstrap runs next and needs it.
        # Multiple analysis worker processes each do this independently -
        # observed directly, intermittently, one of them sometimes hits
        # "Package drupal/core is not installed" anyway, a race somewhere
        # in that double bootstrap sequence across concurrent processes.
        # A single process removes the race entirely; CI already
        # parallelizes across Drupal versions themselves, not within one
        # version's own analysis run, so this costs real time but nothing
        # this project's CI structure actually needed.
        parallel:
            maximumNumberOfProcesses: 1
        level: 9
        # Pinned to tools/phpstan's own floor (8.1), not the module's PHP
        # >=7.3 floor, so results stay consistent regardless of whatever
        # PHP actually executes phpstan (a local host vs. a DDEV container
        # can differ). CI's real PHPUnit matrix already exercises actual
        # PHP 7.3 for the 9.x entries, which catches genuine
        # 7.3-incompatible syntax in this module's own code independently
        # of static analysis.
        phpVersion: 80100
        reportUnmatchedIgnoredErrors: false
        checkMissingTypehints: false
        paths:
            - tests
        excludePaths:
        		- tests/src/Traits/Support/Decorators/EventDispatcher/DecoratedEventDispatcher.php
        ignoreErrors:
        		- '#Unsafe usage of new static\(\)#'
        		# QueryInterface::range()'s own docblock in Drupal core <9.5 incorrectly
        		# declares both $start and $length as `null` (the real, native signature
        		# is untyped: range($start = NULL, $length = NULL)) - a stale docblock bug
        		# in core itself, fixed by 9.5+, not a real incompatibility in code that
        		# actually passes an int.
        		- '#^Parameter \#[12] \$(start|length) of method Drupal\\Core\\Entity\\Query\\QueryInterface\:\:range\(\) expects null, int given\.$#'
        		- '#Cannot call method transform\(\) on mixed#'
        		- '#Cannot call method whenEmpty\(\) on mixed#'
        		- '#Cannot call method mapInto\(\) on mixed#'
        		# KernelTestBase's own $container property is only ever
        		# actually null before setUp() runs and bootKernel() sets it -
        		# every test method (and anything only ever called from one)
        		# always runs after that. PHPStan has no way to know setUp()
        		# already ran by the time a test method's own body executes.
        		- '#^Cannot call method \w+\(\) on Drupal\\Core\\DependencyInjection\\ContainerBuilder\|null\.$#'
        		# #[Test] and #[RunTestsInSeparateProcesses] are PHP 8
        		# attributes referencing PHPUnit\Framework\Attributes
        		# classes that only exist from PHPUnit 10 onwards - some
        		# supported Drupal majors' own drupal/core-dev still
        		# bundles an older PHPUnit (9.x) lacking that namespace
        		# entirely. Harmless either way: that PHPUnit major never
        		# introspects attributes at all (it predates them), so it
        		# never tries to resolve the class this flags as missing.
        		- '#^Attribute class PHPUnit\\Framework\\Attributes\\(Test|RunTestsInSeparateProcesses) does not exist\.$#'
        bootstrapFiles:
        		- tools/phpstan/restore-autoloader-priority.php
includes:
    - tools/phpstan/pre-drupal-autoload.neon
    - tools/phpstan/vendor/mglaman/phpstan-drupal/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon
