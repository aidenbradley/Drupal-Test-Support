parameters:
        level: 9
        # Pinned to tools/phpstan's own floor (8.1), not the module's PHP
        # >=7.3 floor, so results stay consistent regardless of whatever
        # PHP actually executes phpstan (a local host vs. a DDEV container
        # can differ). CI's real PHPUnit matrix already exercises actual
        # PHP 7.3 for the 9.x entries, which catches genuine
        # 7.3-incompatible syntax in this module's own code independently
        # of static analysis.
        phpVersion: 80100
        reportUnmatchedIgnoredErrors: false
        checkMissingTypehints: false
        paths:
            - tests
        excludePaths:
        		- tests/src/Traits/Support/Decorators/EventDispatcher/DecoratedEventDispatcher.php
        ignoreErrors:
        		- '#Unsafe usage of new static\(\)#'
        		- '#^Parameter \#2 \$length of method Drupal\\Core\\Entity\\Query\\QueryInterface\:\:range\(\) expects null, int given\.$#'
        		- '#Cannot call method transform\(\) on mixed#'
        		- '#Cannot call method whenEmpty\(\) on mixed#'
        		- '#Cannot call method mapInto\(\) on mixed#'
includes:
    - tools/phpstan/vendor/mglaman/phpstan-drupal/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon
