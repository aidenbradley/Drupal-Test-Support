{
    "name": "aidenbradley/test-support",
    "description": "Provides various traits to help test setup and assertions in Drupal Kernel tests",
    "type": "drupal-module",
    "require": {
        "php": ">=7.3.0",
        "opis/closure": "^3.6",
        "nesbot/carbon": "^2.69",
        "illuminate/collections": ">=8.83",
        "symfony/finder": "^5"
    },
    "require-dev": {
        "brianium/paratest": "^6.9 || ^7.0",
        "symplify/easy-coding-standard": "^11.5",
        "behat/mink": "^1.9",
        "phpspec/prophecy-phpunit": "^2",
        "symfony/phpunit-bridge": "^5",
        "mikey179/vfsstream": "^1.6",
        "webflo/drupal-finder": "~1.2.2",
        "phpunit/phpunit": ">=9 <12"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Aiden Bradley",
            "email": "mraidenbradley@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "infection/extension-installer": true
        },
        "audit": {
            "abandoned": "ignore"
        },
        "policy": {
            "advisories": {
                "ignore-id": [
                    "PKSA-z3gr-8qht-p93v",
                    "PKSA-qccq-2pht-gg3w",
                    "PKSA-5jz8-6tcw-pbk4"
                ]
            }
        }
    },
    "scripts": {
        "fix:code-smells": "vendor/bin/ecs --fix",

        "test:code-smells": "vendor/bin/ecs",

        "test:types": "php -d memory_limit=4G tools/phpstan/vendor/bin/phpstan analyse -c phpstan.neon",
        "test:mess": "vendor/bin/phpmd tests/src/Traits ansi phpmd.xml",

        "post-install-cmd": "@php bin/install-static-analysis-tooling.php",
        "post-update-cmd": "@php bin/install-static-analysis-tooling.php"
    }
}
